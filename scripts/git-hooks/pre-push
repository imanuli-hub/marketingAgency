#!/usr/bin/env bash
# Blocks pushes that would publish new secrets or Higgsfield asset URLs.
# Install once per clone: npm run hooks
#
# Asset URLs (CDN links to unreleased videos, with the account's storage id)
# are allowed only once the owner has made the repository private:
#   git config tie.repoPrivate true
set -euo pipefail

SECRET='sk-ant-[A-Za-z0-9_-]{8,}|AIza[0-9A-Za-z_-]{30,}|ya29\.[0-9A-Za-z_-]+|1//0[0-9A-Za-z_-]{20,}|GOCSPX-|ghp_[A-Za-z0-9]{20,}|github_pat_|-----BEGIN [A-Z ]*PRIVATE KEY|"(client_secret|refresh_token|access_token)"[[:space:]]*:[[:space:]]*"[^"]+'
ASSET='https://[a-z0-9]+\.cloudfront\.net/|upload\.higgsfield\.ai|user_[A-Za-z0-9]{20,}'
private=$(git config --get tie.repoPrivate || echo false)
zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  added=$(git log -p --format= $range -- . ':(exclude)scripts/git-hooks' | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  if echo "$added" | grep -qE "$SECRET"; then
    echo "pre-push: BLOCKED, outgoing commits add something that looks like a credential:" >&2
    echo "$added" | grep -nE "$SECRET" | cut -c1-120 >&2
    status=1
  fi
  if [ "$private" != "true" ] && echo "$added" | grep -qE "$ASSET"; then
    n=$(echo "$added" | grep -cE "$ASSET")
    echo "pre-push: BLOCKED, $n added line(s) contain Higgsfield asset URLs while the repo is public." >&2
    echo "  Keep these commits local until the repo is private, then: git config tie.repoPrivate true" >&2
    status=1
  fi
  if git diff --name-only $range 2>/dev/null | grep -qE '(^|/)\.env($|\.)' ; then
    git diff --name-only $range | grep -E '(^|/)\.env' | grep -qv '\.env\.example$' && { echo "pre-push: BLOCKED, .env file in outgoing commits" >&2; status=1; }
  fi
done
exit $status
